{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign.schema.json",
  "title": "Campaign spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["icp", "headline", "subhead", "primaryAction", "hero"],
  "properties": {
    "icp": { "type": "string", "minLength": 1, "maxLength": 80 },
    "headline": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subhead": { "type": "string", "minLength": 1, "maxLength": 280 },
    "offer": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 140 }
    },
    "proof": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "who"],
        "properties": {
          "quote": { "type": "string", "maxLength": 220 },
          "who": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "faq": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q", "a"],
        "properties": {
          "q": { "type": "string", "maxLength": 120 },
          "a": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "alt"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.(svg|webp|jpg|jpeg|png|avif)$" },
        "alt": { "type": "string", "maxLength": 120 }
      }
    },
    "primaryAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "type": "string", "enum": ["form", "link"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "href": { "type": "string", "maxLength": 300 },
        "fields": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "label", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "label": { "type": "string", "maxLength": 40 },
              "type": { "type": "string", "enum": ["text", "email", "tel"] },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "defaultSource": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "oneLink": { "type": "string", "maxLength": 300 },
    "thankYou": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "redirectDelayMs": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "showEarningsPotential": { "type": "boolean" },
    "earningsSource": { "type": "string", "minLength": 1, "maxLength": 300 },
    "legal": { "type": "string", "maxLength": 280 },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stores", "continueLabel", "roleTitle", "roles", "checks", "matchLabel", "matchLines", "matchOutcome", "payTitle", "pay", "finalTitle", "finalBody"],
      "properties": {
        "storesPrompt": { "type": "string", "maxLength": 80 },
        "stores": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "continueLabel": { "type": "string", "minLength": 1, "maxLength": 48 },
        "roleTitle": { "type": "string", "maxLength": 80 },
        "roles": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": { "type": "string", "maxLength": 40 },
              "body": { "type": "string", "maxLength": 240 }
            }
          }
        },
        "checksLegend": { "type": "string", "maxLength": 80 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "maxLength": 160 }
        },
        "matchLabel": { "type": "string", "maxLength": 48 },
        "matchLines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 80 }
        },
        "matchOutcome": { "type": "string", "maxLength": 120 },
        "payTitle": { "type": "string", "maxLength": 80 },
        "pay": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label", "detail"],
            "properties": {
              "value": { "type": "string", "maxLength": 24 },
              "label": { "type": "string", "maxLength": 40 },
              "detail": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "finalTitle": { "type": "string", "maxLength": 80 },
        "finalBody": { "type": "string", "maxLength": 220 },
        "reassurance": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 140 }
        }
      }
    }
  }
}

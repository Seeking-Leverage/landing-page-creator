{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign.schema.json",
  "title": "Campaign spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["icp", "headline", "subhead", "primaryAction", "hero"],
  "properties": {
    "icp": { "type": "string", "minLength": 1, "maxLength": 80 },
    "headline": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subhead": { "type": "string", "minLength": 1, "maxLength": 280 },
    "offer": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 140 }
    },
    "proof": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "who"],
        "properties": {
          "quote": { "type": "string", "maxLength": 220 },
          "who": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "faq": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q", "a"],
        "properties": {
          "q": { "type": "string", "maxLength": 120 },
          "a": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "alt"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.(svg|webp|jpg|jpeg|png|avif)$" },
        "alt": { "type": "string", "maxLength": 120 }
      }
    },
    "primaryAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "type": "string", "enum": ["form", "link"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "href": { "type": "string", "maxLength": 300 },
        "fields": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "label", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "label": { "type": "string", "maxLength": 40 },
              "type": { "type": "string", "enum": ["text", "email", "tel"] },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "legal": { "type": "string", "maxLength": 280 }
  }
}

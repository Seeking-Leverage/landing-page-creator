{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brand.schema.json",
  "title": "Brand spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "colors", "logo"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tagline": { "type": "string", "maxLength": 140 },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg", "fg", "accent", "accentFg", "muted"],
      "properties": {
        "bg": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
        "fg": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
        "accent": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
        "accentFg": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
        "muted": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" }
      }
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "alt"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.(svg|png|webp)$" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.(svg|png|webp)$" },
        "alt": { "type": "string", "maxLength": 80 }
      }
    },
    "siteUrl": { "type": "string", "maxLength": 300 },
    "privacyUrl": { "type": "string", "maxLength": 300 }
  }
}

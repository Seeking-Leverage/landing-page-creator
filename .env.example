# Copy to .env. Never commit .env.

# Which client spec to build. Must exist under clients/<name>/
CLIENT=_example

# Optional local preview port
PORT=4173

# Your form endpoint only. Leave empty to disable submit (page still renders).
# Must be https:// in production. Do not point this at a shared third-party URL
# you do not control — cloners would spam it.
FORM_ENDPOINT=

# Server-side only. Do not put this in the page. Use it on YOUR form endpoint
# to reject requests that do not present this header from a trusted backend.
# The static page never sees this value.
FORM_KEY=

# Pixels stay off until you set real IDs. Dummy IDs do nothing useful; leave blank.
META_PIXEL_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=
TIKTOK_PIXEL_ID=

# Public site origin after you deploy (used in OG tags). Example: https://lp.example.com
PUBLIC_ORIGIN=

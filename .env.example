# Copy to .env. Never commit .env.

# Which client spec to build. Must exist under clients/<name>/
CLIENT=_example

# Optional local preview port
PORT=4173

# Your form endpoint only. Leave empty to disable submit (page still renders).
# Must be https:// in production. Do not point this at a shared third-party URL
# you do not control — cloners would spam it.
FORM_ENDPOINT=

# Server-side reminder only. The page never sends this. Preflight prints that
# when it is set. Protect the endpoint with an origin allowlist, a rate limit,
# and the honeypot. Do not expect the browser to present this value.
FORM_KEY=

# Pixels stay off until you set real IDs. A bad format fails preflight.
# Google conversion uses GOOGLE_ADS_LEAD_LABEL when set, otherwise GOOGLE_ADS_CONVERSION_LABEL.
# TikTok sends Lead unless TIKTOK_LEAD_EVENT overrides the event name.
META_PIXEL_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_ADS_LEAD_LABEL=
TIKTOK_PIXEL_ID=
TIKTOK_LEAD_EVENT=

# Public site origin after you deploy (used in OG tags). Example: https://lp.example.com
PUBLIC_ORIGIN=
